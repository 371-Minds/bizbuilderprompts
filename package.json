{
  "name": "bizbuilderprompts-mcp",
  "version": "1.0.0",
  "description": "MCP server for BizBuilderPrompts — a curated library of business AI prompts, workflows, and templates",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bizbuilderprompts-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "bun dist/index.js",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "bun src/ingestion/ingester.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fuse.js": "^7.1.0",
    "glob": "^13.0.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "keywords": [
    "mcp",
    "ai",
    "prompts",
    "business",
    "claude"
  ],
  "license": "MIT"
}
